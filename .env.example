# Variáveis de ambiente do Mente Livre.
# Copie este arquivo para ".env.local" (que nunca vai para o Git) e preencha
# os valores reais conforme cada fase do projeto for implementada.

# --- Fase 2: Supabase (banco de dados + autenticação) ---
# URL e chave pública do seu projeto Supabase. Podem ficar visíveis no
# navegador (por isso o prefixo NEXT_PUBLIC_) — o que protege os dados é a
# regra de segurança (RLS) configurada no banco, não o sigilo dessa chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service role" do Supabase. Tem acesso total ao banco, ignorando as
# regras de segurança. NUNCA pode aparecer no navegador — só é usada dentro
# das rotas de backend do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# --- Fase 4: Anthropic (IA que organiza os pensamentos) ---
# Chave da API da Anthropic. Também só é usada no servidor, nunca no navegador.
ANTHROPIC_API_KEY=
