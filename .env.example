# Variáveis de ambiente do Mente Livre.
# Copie este arquivo para ".env.local" (que nunca vai para o Git) e preencha
# os valores reais conforme cada fase do projeto for implementada.

# --- Fase 2: Supabase (banco de dados + autenticação) ---
# URL e chave pública do seu projeto Supabase. Podem ficar visíveis no
# navegador (por isso o prefixo NEXT_PUBLIC_) — o que protege os dados é a
# regra de segurança (RLS) configurada no banco, não o sigilo dessa chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service role" do Supabase. Tem acesso total ao banco, ignorando as
# regras de segurança. NUNCA pode aparecer no navegador — só é usada dentro
# das rotas de backend do servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Chave "secret" do Supabase (formato novo, sb_secret_...) — substitui a
# service_role acima para uso em código novo (Fase 7, leitura privilegiada
# de google_calendar_connections em src/lib/supabase/admin.ts). Mesmo
# acesso total ao banco, ignorando RLS; NUNCA pode aparecer no navegador —
# só server-side. Gerar em Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=

# --- Fase 4: Anthropic (IA que organiza os pensamentos) ---
# Chave da API da Anthropic. Também só é usada no servidor, nunca no navegador.
ANTHROPIC_API_KEY=

# --- Teste manual de isolamento RLS (tests/security/rls.test.mjs) ---
# NÃO faz parte do app em si — usado só ao rodar `npm run test:rls`.
# Reaproveita NEXT_PUBLIC_SUPABASE_URL e NEXT_PUBLIC_SUPABASE_ANON_KEY acima
# (podem vir da configuração local já existente). Além delas, o teste
# precisa das credenciais de DOIS usuários de teste reais e descartáveis,
# criados só para esse fim no Supabase Auth do projeto:
#   USER_A_EMAIL, USER_A_PASSWORD, USER_B_EMAIL, USER_B_PASSWORD
# Por segurança, NÃO preencha essas 4 variáveis aqui nem em .env.local —
# o script (node puro, sem dotenv) não carregaria esse arquivo de qualquer
# forma. Exporte-as temporariamente na sessão do terminal antes de rodar o
# teste, e nunca use contas de usuários finais reais. Ver docs/SECURITY.md.
